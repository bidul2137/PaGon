# --- dodane przy porzadkowaniu bezpieczenstwa (08.2026) ---
# Sekrety srodowiska: do repozytorium trafia wylacznie .env.example.
.env
.env.*
!.env.example

# Pozostale bazy SQLite sa produktem importerow, nie zrodlem danych.
*.sqlite
*.sqlite3
*.db

# Odrzucone wyniki ekstrakcji NIE trafiaja do repozytorium (usunieto katalog
# data/kody_usterek/quarantine/ w 2026-08-12). Zrodlem prawdy jest dokument
# w zrodla/; importer musi jawnie wykluczac taki zbior, zeby ponowne
# uruchomienie go nie odtworzylo — pilnuje tego test bezpieczenstwa.

*.log
*.tmp
*.bak
