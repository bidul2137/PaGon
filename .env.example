# Wzorzec konfiguracji środowiska PaGon.
# Skopiuj do .env i dostosuj. .env NIE trafia do repozytorium.
# Ten plik nie zawiera i nie może zawierać żadnych sekretów.

# Tryb debugowania. 1 włącza debugger Werkzeuga.
# Debugger daje dostęp do interaktywnej konsoli Pythona, więc włączaj go
# wyłącznie lokalnie i nigdy razem z PAGON_HOST=0.0.0.0.
PAGON_DEBUG=0

# Interfejs nasłuchu. 127.0.0.1 oznacza „tylko ta maszyna”.
# Ustaw 0.0.0.0 świadomie i tylko na czas testów w zaufanej sieci lokalnej
# (np. sprawdzenie widoku na telefonie).
PAGON_HOST=127.0.0.1

# Port serwera deweloperskiego.
PAGON_PORT=5000
